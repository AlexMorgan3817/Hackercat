; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hackercat"
config/version="0.1"
run/main_scene="res://Levels/Menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/image="res://floppa.png"
boot_splash/use_filter=false
config/icon="res://floppa.png"
config/windows_native_icon="res://floppa.ico"

[debug]

gdscript/warnings/unused_parameter=0

[dotnet]

project/assembly_name="Runner"

[editor_plugins]

enabled=PackedStringArray("res://addons/dev_time_tracker/plugin.cfg")

